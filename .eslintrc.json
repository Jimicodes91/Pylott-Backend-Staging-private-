{
  "env": {
    "commonjs": true,
    "es2021": true,
    "node": true
  },
  "extends": ["standard", "plugin:prettier/recommended"],
  "parserOptions": {
    "ecmaVersion": 12
  },
  "rules": {
    "no-useless-escape": "off",
    "prefer-regex-literals": "off",
    "prettier/prettier": [
      "error",
      {
        "singleQuote": true,
        "useTabs": false,
        "tabWidth": 2
      }
    ]
  },
  "plugins": ["prettier"]
}
